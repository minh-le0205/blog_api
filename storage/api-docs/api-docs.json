        "/api/v1/posts": {
            "get": {
                "tags": [
                    "Post"
                ],
                "summary": "Danh sách bài viết (có tìm kiếm và lọc)",
                "operationId": "3e0b8e91c600f7c241ad30d7aec9b6d1",
                "parameters": [
                    {
                        "name": "keyword",
                        "in": "query",
                        "description": "Tìm kiếm tiêu đề",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "category_id",
                        "in": "query",
                        "description": "Lọc theo danh mục",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "tag_ids[]",
                        "in": "query",
                        "description": "Lọc theo nhiều tag",
                        "required": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Danh sách bài viết"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Post"
                ],
                "summary": "Tạo mới một bài viết",
                "operationId": "b93eab5c9b4952419d5926ed04bd3ac6",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "title",
                                    "body",
                                    "category_id"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Tiêu đề bài viết"
                                    },
                                    "body": {
                                        "type": "string",
                                        "example": "Nội dung bài viết"
                                    },
                                    "category_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "tag_ids[]": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        }
                                    },
                                    "thumbnail": {
                                        "type": "file"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Tạo bài viết thành công"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
