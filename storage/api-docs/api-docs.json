{
    "openapi": "3.0.0",
    "info": {
        "title": "Blog API Documentation",
        "description": "Tài liệu RESTful API cho dự án Blog (Laravel + Sanctum)",
        "contact": {
            "name": "Minh Le",
            "email": "minh.levunguyen@gmail.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "{{local_domain}}",
            "description": "Local Development"
        }
